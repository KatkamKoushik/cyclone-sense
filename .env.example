# ==============================================================================
# CycloneSense Environment Configuration & API Keys
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Default is SQLite async fallback for zero-dependency local execution
DATABASE_URL=sqlite+aiosqlite:///./cyclonesense.db

# Redis Task Queue & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ------------------------------------------------------------------------------
# External Satellite Services Authentication (OPTIONAL CREDENTIALS)
# ------------------------------------------------------------------------------

# 1. ISRO MOSDAC (Meteorological & Oceanographic Satellite Data Archival Centre)
# Used for: Direct automated ingestion of INSAT-3D / INSAT-3DR HDF5 satellite products
# Portal: https://www.mosdac.gov.in
ISRO_MOSDAC_API_KEY=

# 2. NASA Earthdata (Global Precipitation Measurement, MODIS, VIIRS)
# Used for: Microwave, radar, and advanced IR scientific products
# Portal: https://urs.earthdata.nasa.gov
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# Public Open-Data Satellite Services (NO KEYS REQUIRED)
# ------------------------------------------------------------------------------
# NOAA IBTrACS: Public NetCDF4 archive via NCEI HTTPS (Pre-indexed & configured)
# NOAA GOES-16/18: AWS Open Data anonymous HTTPS S3 bucket (Pre-configured)
